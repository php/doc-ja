      <entry>
       <methodname>Locale::isRightToLeft</methodname> が追加されました。
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>ロケールのテキスト方向を調べる</title>
   <programlisting role="php">
<![CDATA[
<?php

var_dump(Locale::isRightToLeft('en-US'));
var_dump(Locale::isRightToLeft('ar'));
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
bool(false)
bool(true)
]]>
   </screen>
  </example>
 </refsect1>

</refentry>
