<entity name="ext.datetime.duration-too-long">
 <listitem>
  <simpara>
   結果が
   <link linkend="time-duration.intro">期間の最大長</link>
   を超える場合、<exceptionname>Time\TimeException</exceptionname>
   がスローされます。
  </simpara>
 </listitem>
</entity>

