<refentry xml:id="time-duration.frommilliseconds" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::fromMilliseconds</refname>
  <refpurpose>ミリ秒数から期間を作成する</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <modifier>static</modifier> <type>Time\Duration</type><methodname>Time\Duration::fromMilliseconds</methodname>
   <methodparam><type>int</type><parameter>milliseconds</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   <parameter>milliseconds</parameter> ミリ秒の、負でない期間を作成します。
   値は整数の秒数とナノ秒数に正規化されます。
   <property>Time\Duration::$seconds</property> と
   <property>Time\Duration::$nanoseconds</property> プロパティを参照ください。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>milliseconds</parameter></term>
    <listitem>
     <simpara>
      ミリ秒数。
      <literal>0</literal> 以上でなければなりません。
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   新しい <classname>Time\Duration</classname> オブジェクトを返します。
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     <parameter>milliseconds</parameter> が負の場合、
     <exceptionname>ValueError</exceptionname> がスローされます。
    </simpara>
   </listitem>
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.frommilliseconds.example.basic">
   <title><methodname>Time\Duration::fromMilliseconds</methodname> の例</title>
   <programlisting role="php">
<![CDATA[
<?php
var_dump(\Time\Duration::fromMilliseconds(2500));
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
object(Time\Duration)#1 (3) {
  ["seconds"]=>
  int(2)
  ["nanoseconds"]=>
  int(500000000)
  ["negative"]=>
  bool(false)
}
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::fromSeconds</methodname></member>
   <member><methodname>Time\Duration::fromMicroseconds</methodname></member>
   <member><methodname>Time\Duration::fromMinutes</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
