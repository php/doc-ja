<refentry xml:id="cachingiterator.count" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::count</refname>
  <refpurpose>キャッシュ内の要素数を返す</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>int</type><methodname>CachingIterator::count</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   キャッシュ内の要素数を返します。
   これまでに反復処理した要素の数で、内部イテレータの要素数ではありません。
   キャッシュには要素がキーごとに格納されるため、同じキーの要素は後のもので置き換えられます。
  </simpara>
  <simpara>
   <constant>CachingIterator::FULL_CACHE</constant> フラグを設定する必要があります。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   キャッシュ内の要素数を返します。
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   <constant>CachingIterator::FULL_CACHE</constant> フラグが設定されていない場合、
   <exceptionname>BadMethodCallException</exceptionname> をスローします。
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>CachingIterator::count</methodname> の例</title>
   <programlisting role="php">
<![CDATA[
<?php
$iterator = new CachingIterator(
    new ArrayIterator(['a', 'b', 'c']),
    CachingIterator::FULL_CACHE
);

foreach ($iterator as $value) {
    echo $value, ': ', count($iterator), "\n";
}
?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
a: 1
b: 2
c: 3
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
