<refentry xml:id="time-duration.multiplyby" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::multiplyBy</refname>
  <refpurpose>期間を整数倍する</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>Time\Duration</type><methodname>Time\Duration::multiplyBy</methodname>
   <methodparam><type>int</type><parameter>factor</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   この期間を <parameter>factor</parameter> 倍した期間を返します。
   符号は維持されます。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>factor</parameter></term>
    <listitem>
     <simpara>
      乗数。
      <literal>0</literal> 以上でなければなりません。
      <literal>0</literal> の場合、結果は長さ 0 の期間になります。
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   新しい <classname>Time\Duration</classname> オブジェクトを返します。
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     <parameter>factor</parameter> が負の場合、
     <exceptionname>ValueError</exceptionname> がスローされます。
    </simpara>
   </listitem>
   &ext.datetime.duration-too-long;
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.multiplyby.example.basic">
   <title><methodname>Time\Duration::multiplyBy</methodname> の例</title>
   <programlisting role="php">
<![CDATA[
<?php
var_dump(\Time\Duration::fromMilliseconds(1500)->multiplyBy(4));

try {
    \Time\Duration::fromHours(1)->multiplyBy(3_000_000);
} catch (\Time\TimeException $e) {
    echo $e->getMessage(), PHP_EOL;
}
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
object(Time\Duration)#2 (3) {
  ["seconds"]=>
  int(6)
  ["nanoseconds"]=>
  int(0)
  ["negative"]=>
  bool(false)
}
The maximum representable range is 9_223_372_035 seconds (roughly 292 years)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::divideBy</methodname></member>
   <member><methodname>Time\Duration::add</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
