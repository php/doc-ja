<refentry xml:id="time-duration.divideby" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::divideBy</refname>
  <refpurpose>期間を整数で割る</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>Time\Duration</type><methodname>Time\Duration::divideBy</methodname>
   <methodparam><type>int</type><parameter>divisor</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   この期間を <parameter>divisor</parameter> で割った期間を返します。
   1 ナノ秒未満の端数は切り捨てられるため、結果は 0 に近い方向に丸められます。
   符号は維持されます。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>divisor</parameter></term>
    <listitem>
     <simpara>
      除数。
      <literal>0</literal> より大きくなければなりません。
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   新しい <classname>Time\Duration</classname> オブジェクトを返します。
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     <parameter>divisor</parameter> が負の場合、
     <exceptionname>ValueError</exceptionname> がスローされます。
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <parameter>divisor</parameter> が <literal>0</literal> の場合、
     <exceptionname>DivisionByZeroError</exceptionname> がスローされます。
    </simpara>
   </listitem>
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.divideby.example.basic">
   <title><methodname>Time\Duration::divideBy</methodname> の例</title>
   <programlisting role="php">
<![CDATA[
<?php
// 1 ナノ秒未満の端数は切り捨てられます。
var_dump(\Time\Duration::fromSeconds(10)->divideBy(3)->multiplyBy(3));

try {
    \Time\Duration::fromSeconds(10)->divideBy(0);
} catch (DivisionByZeroError $e) {
    echo $e->getMessage(), PHP_EOL;
}
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
object(Time\Duration)#3 (3) {
  ["seconds"]=>
  int(9)
  ["nanoseconds"]=>
  int(999999999)
  ["negative"]=>
  bool(false)
}
Division by zero
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::multiplyBy</methodname></member>
   <member><function>intdiv</function></member>
  </simplelist>
 </refsect1>

</refentry>
