<refentry xml:id="function.gmp-powm" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>gmp_powm</refname>
  <refpurpose>べき乗とモジュロを計算する</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>GMP</type><methodname>gmp_powm</methodname>
   <methodparam><type class="union"><type>GMP</type><type>int</type><type>string</type></type><parameter>num</parameter></methodparam>
   <methodparam><type class="union"><type>GMP</type><type>int</type><type>string</type></type><parameter>exponent</parameter></methodparam>
   <methodparam><type class="union"><type>GMP</type><type>int</type><type>string</type></type><parameter>modulus</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   <parameter>modulus</parameter> を法として
   (<parameter>num</parameter> の <parameter>exponent</parameter> 乗)
   を計算します。
  </simpara>
 </refsect1>


 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>num</parameter></term>
     <listitem>
      <para>
       もととなる数。
      </para>
      &gmp.parameter; 
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>exponent</parameter></term>
     <listitem>
      <para>
       正の数で、<parameter>num</parameter>
       を何乗するかを指定します。
      </para>
      &gmp.parameter; 
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>modulus</parameter></term>
     <listitem>
      <para>
       モジュロ。
      </para>
      &gmp.parameter; 
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   結果を GMP 数で返します。
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   <parameter>exponent</parameter> が負の場合、<exceptionname>ValueError</exceptionname> がスローされます。
  </simpara>
  <simpara>
   <parameter>modulus</parameter> が <literal>0</literal> の場合、
   <exceptionname>DivisionByZeroError</exceptionname> がスローされます。
  </simpara>
  <simpara>
   PHP 8.0.0 より前のバージョンでは、<constant>E_WARNING</constant> が発生していました。
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title><function>gmp_powm</function> の例</title>
    <programlisting role="php">
<![CDATA[
<?php
$pow1 = gmp_powm("2", "31", "2147483649");
echo gmp_strval($pow1) . "\n";
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
2147483648
]]>
    </screen>
   </example>
  </para>
 </refsect1>

</refentry>
