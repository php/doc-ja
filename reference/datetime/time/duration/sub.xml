<refentry xml:id="time-duration.sub" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::sub</refname>
  <refpurpose>期間を減算する</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>Time\Duration</type><methodname>Time\Duration::sub</methodname>
   <methodparam><type>Time\Duration</type><parameter>duration</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   この期間から <parameter>duration</parameter> を減算した期間を返します。
   どちらの期間の符号も考慮されるため、正の期間から負の期間を減算すると、元の期間より長くなります。
   <parameter>duration</parameter> がこの期間より大きい場合、結果は負になります。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>duration</parameter></term>
    <listitem>
     <simpara>
      減算する期間。
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   新しい <classname>Time\Duration</classname> オブジェクトを返します。
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   &ext.datetime.duration-too-long;
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.sub.example.basic">
   <title><methodname>Time\Duration::sub</methodname> の例</title>
   <programlisting role="php">
<![CDATA[
<?php
var_dump(\Time\Duration::fromSeconds(10)->sub(\Time\Duration::fromMilliseconds(2500)));

// より大きな期間を減算すると、負の期間になります。
var_dump(\Time\Duration::fromSeconds(1)->sub(\Time\Duration::fromSeconds(3)));
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
object(Time\Duration)#3 (3) {
  ["seconds"]=>
  int(7)
  ["nanoseconds"]=>
  int(500000000)
  ["negative"]=>
  bool(false)
}
object(Time\Duration)#1 (3) {
  ["seconds"]=>
  int(2)
  ["nanoseconds"]=>
  int(0)
  ["negative"]=>
  bool(true)
}
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::add</methodname></member>
   <member><methodname>Time\Duration::negate</methodname></member>
   <member><methodname>Time\Duration::absolute</methodname></member>
  </simplelist>
 </refsect1>

