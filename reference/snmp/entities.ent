<!-- EN-Revision: e3a18f9f54b62dfa2bec447adb339ff46754e495 Maintainer: KentarouTakeda Status: ready -->
<!--
    See `manual.xml` for XML namespaces defaults.
    Keep the lines under 79 columns, to make the process of manual
    translation easier, and to avoid wrap-around in some other contexts.
-->
<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.snmp.changelog.object-id-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   <parameter>object_id</parameter> が空の配列の場合、
   <exceptionname>ValueError</exceptionname> をスローするようになりました。
   これより前のバージョンでは、<constant>E_WARNING</constant> が発生し、
   &false; を返していました。
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.security-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   <parameter>security_level</parameter> が有効なセキュリティレベルでない場合や、
   <parameter>auth_protocol</parameter> または
   <parameter>privacy_protocol</parameter> に指定したプロトコルがサポートされておらず、
   <parameter>security_level</parameter> がそのプロトコルを使うレベルの場合、
   <exceptionname>ValueError</exceptionname> をスローするようになりました。
   これより前のバージョンでは、<constant>E_WARNING</constant> が発生し、
   &false; を返していました。
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror">
 <row>
  <entry>8.5.0</entry>
  <entry>
   <parameter>hostname</parameter> または <parameter>community</parameter>
   に null バイトが含まれる場合、hostname の長さが 128 バイト以上の場合、
   <parameter>community</parameter> が空文字列の場合、
   hostname に含まれるポートが負の数または 65535 より大きい場合、
   timeout または retries の値が -1 より小さいか大きすぎる場合、
   <exceptionname>ValueError</exceptionname> をスローするようになりました。
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror.v3">
 <row>
  <entry>8.5.0</entry>
  <entry>
   <parameter>hostname</parameter> または <parameter>security_name</parameter>
   に null バイトが含まれる場合、hostname の長さが 128 バイト以上の場合、
   <parameter>security_name</parameter> が空文字列の場合、
   hostname に含まれるポートが負の数または 65535 より大きい場合、
   timeout または retries の値が -1 より小さいか大きすぎる場合、
   <exceptionname>ValueError</exceptionname> をスローするようになりました。
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.set-type-errors">
 <row>
  <entry>8.0.0</entry>
  <entry>
   <parameter>object_id</parameter> が文字列で、<parameter>type</parameter>
   または <parameter>value</parameter> が配列の場合は
   <exceptionname>TypeError</exceptionname> を、
   指定したタイプが 1 文字でない場合は
   <exceptionname>ValueError</exceptionname> をスローするようになりました。
   これより前のバージョンでは、<constant>E_WARNING</constant> が発生し、
   &false; を返していました。
  </entry>
 </row>
</entity>

<entity name="ext.snmp.object-id-valueerror">
 <simpara>
  <parameter>object_id</parameter> が空の配列の場合、
  <exceptionname>ValueError</exceptionname> をスローします。
 </simpara>
</entity>

<entity name="ext.snmp.security-valueerror">
 <simpara>
  <parameter>security_level</parameter> が有効なセキュリティレベルでない場合や、
  <parameter>auth_protocol</parameter> または
  <parameter>privacy_protocol</parameter> に指定したプロトコルがサポートされておらず、
  <parameter>security_level</parameter> がそのプロトコルを使うレベルの場合、
  <exceptionname>ValueError</exceptionname> をスローします。
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror">
 <simpara>
  PHP 8.5.0 以降、<parameter>hostname</parameter> または
  <parameter>community</parameter> に null バイトが含まれる場合、
  <parameter>hostname</parameter> が 128 バイト以上の場合や
  0 から 65535 の範囲外のポートを含む場合、
  <parameter>community</parameter> が空文字列の場合、
  <parameter>timeout</parameter> または <parameter>retries</parameter> が
  <literal>-1</literal> より小さいか大きすぎる場合、
  <exceptionname>ValueError</exceptionname> をスローします。
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror.v3">
 <simpara>
  PHP 8.5.0 以降、<parameter>hostname</parameter> または
  <parameter>security_name</parameter> に null バイトが含まれる場合、
  <parameter>hostname</parameter> が 128 バイト以上の場合や
  0 から 65535 の範囲外のポートを含む場合、
  <parameter>security_name</parameter> が空文字列の場合、
  <parameter>timeout</parameter> または <parameter>retries</parameter> が
  <literal>-1</literal> より小さいか大きすぎる場合、
  <exceptionname>ValueError</exceptionname> をスローします。
 </simpara>
</entity>

<entity name="ext.snmp.set-type-errors">
 <simpara>
  <parameter>object_id</parameter> が文字列で、<parameter>type</parameter>
  または <parameter>value</parameter> が配列の場合、
  <exceptionname>TypeError</exceptionname> をスローします。
  <parameter>object_id</parameter> が文字列で <parameter>type</parameter>
  が 1 文字でない場合や、<parameter>type</parameter> が配列で、
  いずれかのオブジェクト ID のタイプが 1 文字でない場合、
  <exceptionname>ValueError</exceptionname> をスローします。
 </simpara>
</entity>

</entities>
