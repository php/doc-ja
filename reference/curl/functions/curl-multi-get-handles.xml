<refentry xml:id="function.curl-multi-get-handles" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>curl_multi_get_handles</refname>
  <refpurpose>CurlMultiHandle に現在アタッチされている CurlHandle オブジェクトの配列を返す</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>array</type><methodname>curl_multi_get_handles</methodname>
   <methodparam><type>CurlMultiHandle</type><parameter>multi_handle</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   指定した <classname>CurlMultiHandle</classname> に現在アタッチされている
   <classname>CurlHandle</classname> オブジェクトをすべて返します。
   これには、<function>curl_multi_add_handle</function> で追加したハンドルと、
   <constant>CURLMOPT_PUSHFUNCTION</constant> のコールバックが受け入れたハンドルが含まれます。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   &curl.mh.description;
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   <classname>CurlHandle</classname> オブジェクトの配列を返します。
  </simpara>
 </refsect1>

