<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.stream.context-error-handling">
 <simpara>
  <function>stream_context_create</function>
  で作成したコンテキストリソースまたは &null;。
  この関数で発生したストリームのエラーをどう報告するかは、
  コンテキストの<link linkend="context.stream">エラー処理オプション</link>で決まります。
 </simpara>
</entity>

</entities>
