<refentry xml:id="time-duration.unserialize" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::__unserialize</refname>
  <refpurpose>シリアライズされたデータから期間を復元する</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>void</type><methodname>Time\Duration::__unserialize</methodname>
   <methodparam><type>array</type><parameter>data</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   <parameter>data</parameter> 引数の &array; を
   <classname>Time\Duration</classname> オブジェクトにアンシリアライズします。
   このメソッドは <function>unserialize</function> から呼び出されるもので、
   直接呼び出すためのものではありません。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>data</parameter></term>
    <listitem>
     <simpara>
      <type>array</type> 形式の、シリアライズされたデータ。
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   <parameter>data</parameter> が有効な期間を表していない場合、
   <exceptionname>Exception</exceptionname> がスローされます。
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>serialize</function></member>
   <member><function>unserialize</function></member>
   <member><link linkend="language.oop5.magic">マジックメソッド</link></member>
  </simplelist>
 </refsect1>

</refentry>
