<refentry xml:id="cachingiterator.valid" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::valid</refname>
  <refpurpose>現在の要素が有効かどうかをチェックする</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>bool</type><methodname>CachingIterator::valid</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   現在の要素が有効かどうかをチェックします。
  </simpara>
  <simpara>
   <classname>CachingIterator</classname> には、
   <methodname>CachingIterator::rewind</methodname> をコールするまで現在の要素がありません。
   &foreach; では自動的にコールされます。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   現在の要素が有効な場合に &true;、それ以外の場合に &false; を返します。
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::hasNext</methodname></member>
   <member><methodname>CachingIterator::rewind</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
